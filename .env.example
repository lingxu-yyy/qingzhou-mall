# ===== 数据库配置（MySQL）=====
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=qingzhou_mall
DB_PORT=3306
DB_CONNECTION_LIMIT=10

# ===== Redis 配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
# 本地 Redis 无密码时留空
REDIS_PASSWORD=
REDIS_DB=0

# ===== 服务器配置 =====
PORT=3001
NODE_ENV=development

# ===== JWT 密钥（至少 32 位随机字符串）=====
JWT_SECRET=change_me_to_a_random_string_at_least_32_characters_long

# ===== 请求限流 =====
RATE_LIMIT_MAX=100

# ===== 前端 API 配置（必须带 /api 前缀；留空则走 Vite 代理）=====
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_TIMEOUT=15000
