# 数据库配置
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_production_password
DB_NAME=ecshop
DB_PORT=3306
DB_CONNECTION_LIMIT=20

# 服务器配置
PORT=3001

# JWT 密钥 - 生产环境使用更强的密钥
JWT_SECRET=your_strong_production_jwt_secret_here_at_least_32_characters

# 环境模式
NODE_ENV=production

# API配置
VITE_API_BASE_URL=https://yourdomain.com/api
VITE_API_TIMEOUT=15000

# 请求限流配置
RATE_LIMIT_MAX=50

# CORS配置 - 生产环境只允许指定域名
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com